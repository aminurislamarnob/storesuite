{
	"name": "pluginizelab/storesuite",
	"description": "This plugin enable frontend store management system for WooCommerce simple type product.",
	"license": "GPL2",
	"autoload": {
		"psr-4": {
			"PluginizeLab\\StoreSuite\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"PluginizeLab\\StoreSuite\\Test\\": "tests/php/src/"
		}
	},
	"authors": [
		{
			"name": "Aminur Islam Arnob",
			"email": "contact@pluginizelab.dev",
			"homepage": "https://wordpress.org/plugins/storesuite/"
		}
	],
	"minimum-stability": "dev",
	"require-dev": {
		"wp-coding-standards/wpcs": "dev-develop",
		"dealerdirect/phpcodesniffer-composer-installer": "^0.7.2",
		"tareq1988/wp-php-cs-fixer": "dev-master",
		"phpcompatibility/phpcompatibility-wp": "dev-master",
		"phpunit/phpunit": "~8.5",
		"wp-phpunit/wp-phpunit": "^6.1",
		"yoast/phpunit-polyfills": "^1.0"
	},
	"scripts": {
		"test": [
			"vendor/bin/phpunit"
		],
		"phpcs": [
			"vendor/bin/phpcs -p -s"
		],
		"phpcs:report": [
			"vendor/bin/phpcs --report-file='phpcs-report.txt'"
		],
		"phpcbf": [
			"vendor/bin/phpcbf -p"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4.33"
		}
	},
	"require": {
		"php": ">=7.4",
		"appsero/client": "^2.0"
	}
}
