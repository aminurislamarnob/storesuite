# Copy to .env and adjust for your environment.

# Base URL of the WordPress site under test.
BASE_URL=http://127.0.0.1:9999

# Test users (created by bin/e2e-provision.sh).
ADMIN_USER=admin
ADMIN_PASSWORD=password
MANAGER_USER=manager
MANAGER_PASSWORD=password
CUSTOMER_USER=customer
CUSTOMER_PASSWORD=password

# Application passwords for the REST API specs — printed by
# bin/e2e-provision.sh (spaces in the value are fine).
ADMIN_APP_PASSWORD=
MANAGER_APP_PASSWORD=

# Optional: absolute path to a Chromium binary when the Playwright-managed
# download is unavailable (e.g. sandboxed environments).
# PW_CHROMIUM_PATH=/opt/pw-browsers/chromium
